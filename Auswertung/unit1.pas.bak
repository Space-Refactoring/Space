unit Unit1;

{$mode objfpc}{$H+}

interface

uses
  Classes, SysUtils, FileUtil, Forms, Controls, Graphics, Dialogs, StdCtrls, Dos;

type

  { TForm1 }

  TForm1 = class(TForm)
    Button1: TButton;
    Edit1: TEdit;
    Memo1: TMemo;
    procedure Button1Click(Sender: TObject);
  private
    { private declarations }
  public
    { public declarations }
  end;

var
  Form1: TForm1;

implementation

{$R *.lfm}
type
  str10  = string[10];
  str20  = string[20];
  str40  = string[40];
  str80  = string[80];
  Dock = record                                                                 //  Angedocktes Schiff
             Nr       : longint;
             Captain  : str40;
             Typ      : str10;
             Guthaben : longint;
             Legal    : integer;
             LadLegal : str10;
             Illegal  : integer;
             LadIlleg : str10;
            end;
  Ergebnis = record
             Nr       : array [1..100] of str40;
             Captain  : array [1..100] of str40;
             Guthaben : array [1..100] of longint;
  end;

var
  einn     :string[30];                   { name der eingabedatei }
  einf     :text;                         { filediskriptor        }
  Schiff     :Dock;                       { Schiff das angelegt hat }
  Dateiliste : array[1..100] of string;
  Dlvb : byte;
  Auswertung : Ergebnis;

{ TForm1 }
// readonly 	Read-Only file attribute 	$01
// hidden 	Hidden file attribute 	        $02
// sysfile 	System file attribute 	        $04
// volumeid 	Volume ID file attribute 	$08
// directory 	Directory file attribute 	$10
// archive 	Archive file attribute 	        $20
// anyfile 	Match any file attribute 	$3F

//******************************************************************************
function datle (nr : byte) : byte;                      {  Daten aus Datei lesen }
var
  egstr : string;
  erg : byte;                               { Ergebnis: 1 = OK; ff = Fehler }
begin
  erg:=1;                                   {  Noch kein Fehler }
  assign(einf,Form1.edit1.text+'\'+Dateiliste[nr]); {  Handelsdatei lesen }
  {$I-}
  reset(einf);                              {  Auftragsdatei ”ffnen }
  {$I+}
  if IOResult = 0 then begin                {? Datei vorhanden }
    readln(einf,egstr);                     {  Zeile 1 lesen }
    if (egstr = 'Captain') then begin       {? Captain }
      readln(einf,Schiff.Captain);          {  lesen }
    end else begin                          {N Captain}
      erg:=$ff;                             {  Fehler setzen }
    end;                                    {E if: Captain }
    readln(einf,egstr);                     {  Zeile esen }
    if (egstr = 'Raumschiff') then begin    {? Raumschiff }
      readln(einf,Schiff.Typ);              {  lesen }
    end else begin                          {N Raumschiff }
      erg:=$ff;                             {  Fehler setzen }
    end;                                    {E if: Raumschiff }
    readln(einf,egstr);                     {  Zeile esen }
    if (egstr = 'Guthaben') then begin      {? Guthaben }
      readln(einf,Schiff.Guthaben);         {  lesen }
    end else begin                          {N Guthaben}
      erg:=$ff;                             {  Fehler setzen }
    end;                                    {E if: Guthaben }
    readln(einf,egstr);                     {  Zeile esen }
    if (egstr = 'Legaler Auftrag') then begin    {? legaler Auftrag }
      readln(einf,Schiff.Legal);            {  lesen }
    end else begin                          {N legaler Auftrag}
      erg:=$ff;                             {  Fehler setzen }
    end;                                    {E if: legaler Auftrag }
    readln(einf,egstr);                     {  Zeile esen }
    if (egstr = 'Geladen?') then begin      {? Was geladen ? }
      readln(einf,Schiff.LadLegal);         {  lesen }
    end else begin                          {N Guthaben}
      erg:=$ff;                             {  Fehler setzen }
    end;                                    {E if: Guthaben }
    readln(einf,egstr);                     {  Zeile esen }
    if (egstr = 'Illegaler Auftrag') then begin    {? ilegaler Auftrag }
      readln(einf,Schiff.Illegal);          {  lesen }
    end else begin                          {N ilegaler Auftrag}
      erg:=$ff;                             {  Fehler setzen }
    end;                                    {E if: ilegaler Auftrag }
    readln(einf,egstr);                     {  Zeile esen }
    if (egstr = 'Geladen?') then begin      {? Was geladen ? }
      readln(einf,Schiff.LadIlleg);         {  lesen }
    end else begin                          {N Guthaben}
      erg:=$ff;                             {  Fehler setzen }
    end;                                    {E if: Guthaben }
    close(einf);                            {  Datei schlieáen }
  end else begin                            {N Datei vorhanden }
      erg:=$ff;                             {  Fehler setzen }
  end;                                      {E if: Datei vorhanden }
  datle:=erg;
end;
//******************************************************************************
procedure TForm1.Button1Click(Sender: TObject);
var
  Dir  : SearchRec;
  i    : byte;
  k    : byte;
  zw   : string;
  Fehler : boolean;
  Captain : str40;
  Guthaben: longint;
  Nr : str40;
begin
    Dlvb:=0;
    Dir.name:='';
    FindFirst(edit1.Text+'\dat_*.txt',faAnyFile,Dir);
    while (DosError=0) do
     begin
       inc(Dlvb);
       Dateiliste[Dlvb]:=Dir.name;
       FindNext(Dir);
     end;
    FindClose(Dir);
    Fehler:=false;
    if (Dlvb > 1) then begin
      for i:=1 to Dlvb do begin
        k:=Datle(i);
        if (k <> 1) then Fehler:=true;
        Auswertung.Captain[i]:=Schiff.Captain;
        Auswertung.Guthaben[i]:=Schiff.Guthaben;
        Auswertung.Nr[i]:=Dateiliste[i];
      end;
      if (Fehler = True) then begin
        Memo1.Text:='Fehler';
      end else begin
        for k:=1 to Dlvb do begin
          for i:=1 to Dlvb-1 do begin
            if Auswertung.Guthaben[i+1]>Auswertung.Guthaben[i] then begin
              Captain:=Auswertung.Captain[i];
              Guthaben:=Auswertung.Guthaben[i];
              Nr:=Auswertung.Nr[i];

              Auswertung.Captain[i]:=Auswertung.Captain[i+1];
              Auswertung.Guthaben[i]:=Auswertung.Guthaben[i+1];
              Auswertung.Nr[i]:=Auswertung.Nr[i+1];

              Auswertung.Captain[i+1]:=Captain;
              Auswertung.Guthaben[i+1]:=Guthaben;
              Auswertung.Nr[i+1]:=Nr;

            end;
          end;
        end;
        Memo1.Text:='';
        for i:=1 to Dlvb do begin
          zw:=IntToStr(i)+': ';
          repeat zw:=zw+' '; until(length(zw) >= 5);
          zw:=zw+Auswertung.Nr[i];
          repeat zw:=zw+' '; until(length(zw) >= 25);
          zw:=zw+Auswertung.Captain[i];
          repeat zw:=zw+' '; until(length(zw) >= 45);
          zw:=zw+IntToStr(Auswertung.Guthaben[i]);
          Memo1.Lines.Add(zw);
        end;
      end;
      end else begin
        Memo1.Text:='Keine Dateien gefunden';
    end;
end;

end.

